{
  "expo": {
    "name": "Smokey Grillz",
    "slug": "smokey-grillz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "smokeygrillz",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0D0F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smokeygrillz.app"
    },
    "android": {
      "package": "com.smokeygrillz.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0F",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#E8700A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Smokey Grillz to access your photos so you can add menu item pictures."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "337d5d1d-c454-4c87-bded-1d7a014342ae"
      }
    },
    "owner": "jai-fore"
  }
}
